# Database
DATABASE_URL="postgresql://hris:hris_dev_pw@localhost:5432/sikomendo_dev"

# Authentication
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-required"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# File Storage (Cloudinary)
# For development, you can use placeholder values if mocking file uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional: Error Tracking (Sentry)
# SENTRY_DSN=""

# Translation workflow
# No API key required — uses AI assistant prompts (ChatGPT / Claude).
# Run: npx tsx scripts/generate-translations.ts --export
# Then: npx tsx scripts/generate-translations.ts --apply

# Scheduled Job Security
# Authenticates POST/GET requests to /api/attendance/jobs/detect and
# /api/attendance/jobs/finalize. Must be at least 32 characters.
# Generate with: openssl rand -hex 32
ATTENDANCE_JOB_SECRET="your-job-secret-min-32-characters-required"
#
# Cron deployment:
#   Vercel — add to vercel.json (Vercel injects Authorization header automatically):
#     "crons": [
#       { "path": "/api/attendance/jobs/detect",  "schedule": "0 7 * * 1-5" },
#       { "path": "/api/attendance/jobs/finalize", "schedule": "0 14 * * 1-5" }
#     ]
#   Railway / external — configure your cron to POST with:
#     Authorization: Bearer $ATTENDANCE_JOB_SECRET
